  "private": true,
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6"
  },
  "overrides": {
    "gray-matter": "npm:@11ty/gray-matter@2.1.0",
    "js-yaml": "4.3.0",
    "anymatch": {
      "picomatch": "2.3.2"
    },
    "readdirp": {
