<div class="gallery-page">
  <header class="gallery-hero">
    <div class="gallery-hero__content">
      <p class="section-kicker">Bildgalleri</p>
      <h1>Exempel på trafikskador</h1>
      <p class="gallery-hero__lead">
        Trafikskador kan drabba allt från portar och räcken till
        belysning, skyltar och byggnader. Här visas några exempel på
        skador som kan bli föremål för utredning och ersättning.
      </p>
    </div>

    <aside class="gallery-hero__note">
      <strong>{{ galleryImages | length }} skadeexempel</strong>
      <p>
        Klicka på en bild för att visa den i större format. Använd
        piltangenterna för att gå mellan bilderna.
      </p>
    </aside>
  </header>

  <section class="damage-gallery" aria-label="Exempel på trafikskador">
    {% for image in galleryImages %}
      <button
        class="gallery-card"
        type="button"
        data-gallery-item
        data-gallery-src="{{ image.src }}"
        data-gallery-alt="{{ image.alt }}"
        data-gallery-caption="{{ image.caption }}"
        aria-label="Visa större bild: {{ image.caption }}"
      >
        <img
          src="{{ image.src }}"
          alt="{{ image.alt }}"
          loading="lazy"
          decoding="async"
        >
        <span class="gallery-card__overlay">
          <span>{{ image.caption }}</span>
          <span class="gallery-card__expand" aria-hidden="true">↗</span>
        </span>
      </button>
    {% endfor %}
  </section>

  <div
    class="gallery-lightbox"
    data-gallery-lightbox
    hidden
  >
    <div
      class="gallery-lightbox__backdrop"
      data-gallery-close
      aria-hidden="true"
    ></div>

    <div
      class="gallery-lightbox__dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="gallery-lightbox-caption"
    >
      <button
        class="gallery-lightbox__close"
        type="button"
        data-gallery-close
        aria-label="Stäng bildvisningen"
      >
        <span aria-hidden="true">×</span>
      </button>

      <button
        class="gallery-lightbox__navigation gallery-lightbox__navigation--previous"
        type="button"
        data-gallery-previous
        aria-label="Visa föregående bild"
      >
        <span aria-hidden="true">‹</span>
      </button>

      <figure class="gallery-lightbox__figure">
        <img
          class="gallery-lightbox__image"
          data-gallery-lightbox-image
          src=""
          alt=""
        >
        <figcaption
          class="gallery-lightbox__caption"
          id="gallery-lightbox-caption"
          data-gallery-lightbox-caption
        ></figcaption>
      </figure>

      <button
        class="gallery-lightbox__navigation gallery-lightbox__navigation--next"
        type="button"
        data-gallery-next
        aria-label="Visa nästa bild"
      >
        <span aria-hidden="true">›</span>
      </button>
    </div>
  </div>
</div>
